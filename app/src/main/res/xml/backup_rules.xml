<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Navigation history, favorites, custom provider keys and cached location-derived
         data stay on-device and are not copied into cloud backups. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
