# TOMTOM_API_KEY: Optional live traffic provider key.
# Configure through local .env / CI secret or the in-app Traffic Inspector.
# Never commit a real key.
TOMTOM_API_KEY=MY_TOMTOM_API_KEY

# LIVE_SHARE_BASE_URL: Real live-sharing backend. The app has a safe default,
# but deployments can override it without rebuilding source.
LIVE_SHARE_BASE_URL=https://lanu-harita-live-share.onrender.com
